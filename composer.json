{
    "name": "sukarix/sukarix",
    "description": "The Sukarix Framework - Just the Right Amount of Sweetness and Efficiency on Top of Fat-Free",
    "type": "library",
    "version": "0.5.0",
    "keywords": [
        "framework",
        "sukarix",
        "php",
        "fat-free"
    ],
    "license": "MIT",
    "homepage": "https://sukarix.com",
    "support": {
        "issues": "https://github.com/sukarix/sukarix/issues",
        "source": "https://github.com/sukarix/sukarix"
    },
    "authors": [
        {
            "name": "RIADVICE",
            "email": "contact@riadvice.com"
        },
        {
            "name": "Ghazi Triki",
            "email": "ghazi.triki@riadvice.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../statera"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sukarix\\": "src/Sukarix/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "": "tests/src/",
            "Fixtures\\Actions\\": "tests/fixtures/Actions/"
        }
    },
    "require": {
        "php": "^8.4",
        "bcosca/fatfree-core": "^3.9.2",
        "ikkez/f3-cortex": "^v1.7.8",
        "ikkez/f3-events": "^1.0.3",
        "ikkez/f3-mailer": "^1.2.3",
        "kevinlebrun/colors.php": "^1.0.3",
        "matthiasmullie/minify": "^1.3.75",
        "mikehaertl/php-shellcommand": "^1.7.0",
        "gabrielelana/byte-units": "^0.5.0",
        "marc-mabe/php-enum": "^v4.7.2",
        "monolog/monolog": "^3.10.0",
        "nesbot/carbon": "^3.11.1",
        "peppeocchi/php-cron-scheduler": "^v4.0",
        "tracy/tracy": "^v2.11.0",
        "sukarix/f3-access": "^v1.2.3",
        "xfra35/f3-multilang": "^v1.3.2",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "bramus/monolog-colored-line-formatter": "^3.1",
        "friendsofphp/php-cs-fixer": "^v3.93.1",
        "nunomaduro/phpinsights": "^2.14.2",
        "phpmetrics/phpmetrics": "^v2.9.1",
        "phpstan/phpstan": "^2.2.14",
        "php-parallel-lint/php-parallel-lint": "^1.4.0",
        "rector/rector": "^2.6.7",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13.6",
        "sukarix/statera": "^v0.5.0",
        "vimeo/psalm": "^6.13.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": false,
        "process-timeout": 600,
        "preferred-install": "dist",
        "github-protocols": [
            "https"
        ],
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "php tools/statera.php",
        "lint": "parallel-lint src tests",
        "check": [
            "@lint",
            "@test",
            "@code-check"
        ],
        "code-check": "phpstan analyse --no-progress",
        "coverage": "XDEBUG_MODE=coverage php tools/statera.php \"?statera=withCoverage\"",
        "csfix": "XDEBUG_MODE=off PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --allow-risky yes",
        "sniffer": "phpcs src/ tests/",
        "phpcbf": "phpcbf src/ tests/",
        "phpinsights": "./vendor/bin/phpinsights",
        "phpmetrics": "./vendor/bin/phpmetrics --report-html=metrics src/",
        "psalm": "./vendor/bin/psalm --threads=8 --diff"
    },
    "suggest": {
        "ikkez/f3-middleware": "A middleware router plugin for PHP Fat-Free Framework"
    }
}
